# Base SQLite local; se crea automáticamente al iniciar la API.
DATABASE_URL=sqlite:///./data/cctv_noc.db
INTERVALO_S=60
SEED_DEMO_DATA=false
MONITORING_ENABLED=true
MONITORING_DEVICE_IDS=DVR-K,K01,K02,K03
CCTV_VISION=0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_S=180
OLLAMA_KEEP_ALIVE=30m
